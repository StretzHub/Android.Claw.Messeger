# Port auf dem der MCP-Server lauscht (Standard: 3001)
PORT=3001

# Optionaler API-Token für Authentifizierung (empfohlen!)
# Muss in Claude Code MCP-Konfiguration als Header mitgegeben werden
# Leer lassen um Auth zu deaktivieren (nur im Heimnetz verwenden!)
API_TOKEN=

# Log-Level: silent | info | warn | error
LOG_LEVEL=info
