# Claude API Key – erhältlich unter https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# System-Prompt für Claude (optional – Standard wird verwendet wenn leer)
SYSTEM_PROMPT=Du bist ein hilfreicher persönlicher Assistent. Antworte präzise und freundlich.

# Maximale Anzahl Nachrichten im Gesprächsverlauf pro Kontakt (Standard: 20)
MAX_HISTORY=20

# Log-Level: silent | info | warn | error (Standard: info)
LOG_LEVEL=info
